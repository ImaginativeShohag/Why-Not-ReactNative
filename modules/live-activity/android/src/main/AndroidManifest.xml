<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Receives the Pause / Resume / End taps from the ongoing notification.
         Not exported: only our own PendingIntents can reach it. The home-screen
         widget receiver is added to the app manifest by
         plugins/withWorkoutCapabilities.js. -->
    <receiver
      android:name="expo.modules.liveactivity.LiveActivityActionReceiver"
      android:exported="false" />
  </application>
</manifest>
