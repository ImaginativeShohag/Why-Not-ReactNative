{
  "name": "why-not-react-native-promo",
  "private": true,
  "description": "Motion-graphics promo for the Why-Not-ReactNative tutorial site (Remotion).",
  "scripts": {
    "voice": "node scripts/voice.mjs",
    "sfx": "node scripts/sfx.mjs",
    "studio": "remotion studio",
    "render": "remotion render Promo output/promo.mp4",
    "poster": "remotion still Poster output/poster.png",
    "render:portrait": "remotion render PromoPortrait output/promo-portrait.mp4",
    "poster:portrait": "remotion still PosterPortrait output/poster-portrait.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
